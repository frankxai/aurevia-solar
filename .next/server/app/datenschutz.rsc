14:["$","ul",null,{"children":[["$","li",null,{"children":"Auskunft über die zu Ihrer Person gespeicherten Daten (Art. 15 DSGVO),"}],["$","li",null,{"children":"Berichtigung unrichtiger Daten (Art. 16 DSGVO),"}],["$","li",null,{"children":"Löschung (Art. 17 DSGVO),"}],["$","li",null,{"children":"Einschränkung der Verarbeitung (Art. 18 DSGVO),"}],["$","li",null,{"children":"Datenübertragbarkeit (Art. 20 DSGVO) sowie"}],["$","li",null,{"children":"Widerspruch gegen die Verarbeitung, die auf Art. 6 Abs. 1 lit. f DSGVO beruht (Art. 21 DSGVO)."}]]}]
